PORT=3001
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=quantum_prop
DB_PASSWORD=your_postgres_password
DB_PORT=5432

# CORS / public URLs — required for crypto payment redirects and webhooks to work correctly
FRONTEND_URL=http://localhost:5174
BACKEND_PUBLIC_URL=http://localhost:3002

# BitPay crypto payments — see backend/src/config/bitpay.ts. Leave unset to disable crypto
# checkout gracefully (returns 503 instead of crashing). Obtain via the BitPay pairing flow:
# https://bitpay.readme.io/reference/node-full-sdk-getting-started
BITPAY_PRIVATE_KEY=
BITPAY_MERCHANT_TOKEN=
BITPAY_ENVIRONMENT=Test
